# Copy to .env for local development or production deployment.
APP_ENV=development
SECRET_KEY=replace-with-a-strong-32-plus-character-secret
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://snickylink:replace-with-a-strong-database-password@localhost:5432/snickylink
REDIS_HOST=localhost
AUTO_CREATE_TABLES=true
RUN_SCHEDULER=false
RUN_EVENT_WORKER=false
AI_PROVIDER=mock
MEDIA_SIGNING_KEY=replace-with-a-strong-32-plus-character-media-signing-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

{
  "name": "SnickyLink",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "start": "bash .cursor/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "bash .cursor/scripts/run-api.sh"
    },
    {
      "name": "web",
      "command": "bash .cursor/scripts/run-web.sh"
    }
  ],
  "ports": [
    8000,
    8080
  ]
}
